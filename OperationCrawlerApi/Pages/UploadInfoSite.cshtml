@page
@model OperationCrawlerApi.Pages.UploadInfoSiteModel
@{
    ViewData["Title"] = "Upload Info Site";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            max-width: 800px;
            margin: 50px auto;
            padding: 20px;
        }
        .upload-container {
            border: 2px dashed #ccc;
            border-radius: 8px;
            padding: 40px;
            text-align: center;
            background-color: #f9f9f9;
        }
        .form-group {
            margin: 20px 0;
        }
        .btn-upload {
            background-color: #4CAF50;
            color: white;
            padding: 12px 30px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 16px;
        }
        .btn-upload:hover {
            background-color: #45a049;
        }
        .btn-upload:disabled {
            background-color: #ccc;
            cursor: not-allowed;
        }
        .message {
            margin-top: 20px;
            padding: 15px;
            border-radius: 4px;
        }
        .message.success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
        .message.error {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
        input[type="file"] {
            padding: 10px;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <h1>@ViewData["Title"]</h1>
    
    <div class="upload-container">
        <form method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label for="apiUrl">
                    <h3>Select Environment</h3>
                </label>
                <select id="apiUrl"
                        name="apiUrl"
                        required
                        style="padding: 10px; font-size: 14px; width: 100%; max-width: 600px;">
                    <option value="http://data-center-001.infosite.sit.oneops.net/api/Automation/UploadGeneralExcel">SIT</option>
                    <option value="http://data-center-001.infosite.klt2u.oneops.net/api/Automation/UploadGeneralExcel">PROD</option>
                </select>
            </div>
            
            <div class="form-group">
                <label for="uploadFile">
                    <h3>Choose file to upload</h3>
                </label>
                <input type="file" 
                       id="uploadFile" 
                       name="uploadFile" 
                       required 
                       onchange="updateFileName()" />
            </div>
            
            <div class="form-group">
                <button type="submit" class="btn-upload">
                    Upload File
                </button>
            </div>
        </form>
    </div>

    @if (Model.Message != null)
    {
        <div class="message @(Model.IsSuccess ? "success" : "error")">
            @Html.Raw(@Model.Message)
        </div>
    }

    <script>
        function updateFileName() {
            const input = document.getElementById('uploadFile');
            const fileName = input.files[0]?.name;
            if (fileName) {
                console.log('Selected file:', fileName);
            }
        }
    </script>
</body>
</html>
